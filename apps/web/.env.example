NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phase 4 — recommendation synthesis (server-side only)
GEMINI_API_KEY=your-gemini-api-key
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Phase C — semantic catalog search (same MiniLM model as scripts/seed.py)
# Without this, search falls back to name/brand keyword matching only.
HF_TOKEN=hf_your_huggingface_token
# HUGGINGFACE_API_KEY=hf_...   # alias also accepted

# Optional: proxy MCP tools to a remote Python gateway instead of local handlers
# MCP_GATEWAY_URL=http://localhost:8080

# After enabling Google in Supabase Dashboard → Authentication → Providers,
# add these Redirect URLs under Authentication → URL Configuration:
#   http://localhost:3000/auth/callback
#   https://YOUR_PRODUCTION_DOMAIN/auth/callback
#
# Full production checklist: apps/web/DEPLOY.md
# Health probe: GET /api/health
# MCP soft rate limit: 10 requests / minute / IP
